{
  "name": "openalex-dss",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "start": "python3 scripts/dss_control.py start",
    "stop": "python3 scripts/dss_control.py stop",
    "status": "python3 scripts/dss_control.py status",
    "restart": "python3 scripts/dss_control.py restart",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "preview:web": "npm --workspace apps/web run preview",
    "test:e2e:web": "npm --workspace apps/web run test:e2e",
    "clean": "python3 scripts/clean_project.py",
    "clean:all": "python3 scripts/clean_project.py --data --deps --empty-old"
  }
}
